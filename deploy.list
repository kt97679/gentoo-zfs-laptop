# deploy.list - the system files ./deploy installs from this checkout (root-owned copies).
# GROUP: base (install-gentoo.sh), desktop (install-unity.sh), tribler (with Podman), brave and
# eiskaltdcpp (world-update plugins, opt-in); deploy updates the groups it deployed before. Destinations: /etc or
# /usr/local only. Values that differ per machine (host name, user, key, ESP) stay in the installers.
# GROUP  MODE  DESTINATION                                                      SOURCE
base     0755  /usr/local/sbin/world-update                                     files/world-update
base     0755  /usr/local/sbin/update-zbm                                       files/update-zbm
